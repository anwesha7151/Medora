rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles: users can read/write their own profile; admins can read all
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }
    
    // Prescriptions: accessible by the owner user and verified clinicians/pharmacies
    match /prescriptions/{prescriptionId} {
      allow read, write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid || request.auth.token.role in ['doctor', 'pharmacy', 'admin']);
    }

    // Medication Reminders: accessible only by the owner user
    match /reminders/{reminderId} {
      allow read, write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Orders: accessible by the user who placed it and the target pharmacy
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
    
    // Public catalog & pharmacy directory read access
    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
